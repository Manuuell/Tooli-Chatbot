# --- Chatwoot ---
# Genera SECRET_KEY_BASE con: openssl rand -hex 64
SECRET_KEY_BASE=cambia_esto_por_un_hex_de_128_caracteres

FRONTEND_URL=http://localhost:3001
DEFAULT_LOCALE=es
INSTALLATION_ENV=docker

NODE_ENV=production
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Postgres (debe coincidir con CHATWOOT_DB_PASSWORD del .env)
POSTGRES_HOST=chatwoot-postgres
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DATABASE=chatwoot

# Redis dedicado
REDIS_URL=redis://chatwoot-redis:6379

# Bloquear registro público (solo el admin crea cuentas)
ENABLE_ACCOUNT_SIGNUP=false

# Almacenamiento local en volumen
ACTIVE_STORAGE_SERVICE=local
