# Entorno SOLO para `npm test`. Todos los valores son falsos y no sirven para
# conectarse a nada: existen porque src/config valida el entorno al importarse,
# así que sin ellos ni siquiera se puede importar un módulo para probarlo.
# No poner credenciales reales aquí — este archivo sí va al repositorio.
NODE_ENV=test
WEBHOOK_SECRET=secreto-de-prueba-no-real
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"prueba","private_key":"no-real","client_email":"prueba@prueba.iam.gserviceaccount.com"}
JWT_SECRET=jwt-de-prueba-solo-para-los-tests-32-chars
REDIS_URL=redis://localhost:6379
